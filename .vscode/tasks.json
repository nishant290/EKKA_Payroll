{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "./${workspaceFolder}/c:/Users/admin/AppData/Roaming/Code/User/workspaceStorage/3b123a1965eca41568a968da88f4919a/ms-dotnettools.csdevkit/PayrollNZ.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "./${workspaceFolder}/c:/Users/admin/AppData/Roaming/Code/User/workspaceStorage/3b123a1965eca41568a968da88f4919a/ms-dotnettools.csdevkit/PayrollNZ.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/PayrollNZ/src/PayrollNZ.Web/PayrollNZ.Web.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "type": "docker-build",
            "label": "docker-build: debug",
            "dependsOn": [
                "build"
            ],
            "dockerBuild": {
                "tag": "payrollnz:dev",
                "target": "base",
                "dockerfile": "${workspaceFolder}/PayrollNZ/src/PayrollNZ.Web/Dockerfile",
                "context": "${workspaceFolder}",
                "pull": true
            },
            "netCore": {
                "appProject": "${workspaceFolder}/PayrollNZ/src/PayrollNZ.Web/PayrollNZ.Web.csproj"
            }
        },
        {
            "type": "docker-build",
            "label": "docker-build: release",
            "dependsOn": [
                "build"
            ],
            "dockerBuild": {
                "tag": "payrollnz:latest",
                "dockerfile": "${workspaceFolder}/PayrollNZ/src/PayrollNZ.Web/Dockerfile",
                "context": "${workspaceFolder}",
                "platform": {
                    "os": "windows",
                    "architecture": "amd64"
                },
                "pull": true
            },
            "netCore": {
                "appProject": "${workspaceFolder}/PayrollNZ/src/PayrollNZ.Web/PayrollNZ.Web.csproj"
            }
        },
        {
            "type": "docker-run",
            "label": "docker-run: debug",
            "dependsOn": [
                "docker-build: debug"
            ],
            "dockerRun": {
                "os": "Windows"
            },
            "netCore": {
                "appProject": "${workspaceFolder}/PayrollNZ/src/PayrollNZ.Web/PayrollNZ.Web.csproj",
                "enableDebugging": true
            }
        },
        {
            "type": "docker-run",
            "label": "docker-run: release",
            "dependsOn": [
                "docker-build: release"
            ],
            "dockerRun": {
                "os": "Windows"
            },
            "netCore": {
                "appProject": "${workspaceFolder}/PayrollNZ/src/PayrollNZ.Web/PayrollNZ.Web.csproj"
            }
        }
    ]
}