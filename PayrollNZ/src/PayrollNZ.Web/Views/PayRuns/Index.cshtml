@model List<PayRun>
@{
    ViewData["Title"] = "Pay runs";
}

<div class="page-head">
    <h1>Pay runs</h1>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> New pay run</a>
</div>

<div class="card">
    <table class="table table-hover mb-0 align-middle">
        <thead><tr><th>Period</th><th>Payment date</th><th>Status</th><th class="num">Employees</th><th class="num">Gross</th><th class="num">Tax</th><th class="num">Net</th><th></th></tr></thead>
        <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.PeriodStart.ToString("dd MMM") – @r.PeriodEnd.ToString("dd MMM yyyy")</td>
                <td>@r.PaymentDate.ToString("dd MMM yyyy")</td>
                <td><span class="badge @(r.Status == PayRunStatus.Posted ? "bg-success" : "bg-secondary")">@r.Status</span></td>
                <td class="num">@r.Payslips.Count</td>
                <td class="num">@r.TotalGross.ToString("C2")</td>
                <td class="num">@r.TotalTax.ToString("C2")</td>
                <td class="num">@r.TotalNet.ToString("C2")</td>
                <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@r.Id">Open</a></td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="8" class="text-center text-muted py-4">No pay runs yet.</td></tr>
        }
        </tbody>
    </table>
</div>
