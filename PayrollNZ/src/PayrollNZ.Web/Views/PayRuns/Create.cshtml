@model PayRunCreateViewModel
@{
    ViewData["Title"] = "New pay run";
}

<div class="page-head"><h1>New pay run</h1></div>

<form asp-action="Create" method="post" class="card" style="max-width: 560px">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
        <p class="text-muted small">Hourly employees are paid from unpaid timesheet entries inside the period. Salaried employees receive one period of salary.</p>
        <div class="row g-3">
            <div class="col-md-6"><label asp-for="PeriodStart" class="form-label"></label>
                <input asp-for="PeriodStart" class="form-control" /><span asp-validation-for="PeriodStart" class="text-danger small"></span></div>
            <div class="col-md-6"><label asp-for="PeriodEnd" class="form-label"></label>
                <input asp-for="PeriodEnd" class="form-control" /><span asp-validation-for="PeriodEnd" class="text-danger small"></span></div>
            <div class="col-md-6"><label asp-for="PaymentDate" class="form-label"></label>
                <input asp-for="PaymentDate" class="form-control" /><span asp-validation-for="PaymentDate" class="text-danger small"></span></div>
        </div>
    </div>
    <div class="card-footer bg-white text-end">
        <a class="btn btn-link" asp-action="Index">Cancel</a>
        <button class="btn btn-primary" type="submit">Create draft</button>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
