@model Shift
@{
    ViewData["Title"] = "Add shift";
    var employees = (List<SelectListItem>)ViewData["Employees"]!;
}

<div class="page-head"><h1>Add shift</h1></div>

<form asp-action="Create" method="post" class="card" style="max-width: 640px">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
        <div class="row g-3">
            <div class="col-12">
                <label asp-for="EmployeeId" class="form-label"></label>
                <select asp-for="EmployeeId" asp-items="employees" class="form-select"><option value="">Select employee…</option></select>
                <span asp-validation-for="EmployeeId" class="text-danger small"></span>
            </div>
            <div class="col-md-6"><label asp-for="ShiftDate" class="form-label"></label>
                <input asp-for="ShiftDate" class="form-control" /><span asp-validation-for="ShiftDate" class="text-danger small"></span></div>
            <div class="col-md-6"><label asp-for="BreakMinutes" class="form-label"></label>
                <input asp-for="BreakMinutes" class="form-control" type="number" min="0" /></div>
            <div class="col-md-6"><label asp-for="StartTime" class="form-label"></label>
                <input asp-for="StartTime" class="form-control" /><span asp-validation-for="StartTime" class="text-danger small"></span></div>
            <div class="col-md-6"><label asp-for="EndTime" class="form-label"></label>
                <input asp-for="EndTime" class="form-control" /><span asp-validation-for="EndTime" class="text-danger small"></span></div>
            <div class="col-12"><label asp-for="Notes" class="form-label"></label><input asp-for="Notes" class="form-control" /></div>
        </div>
    </div>
    <div class="card-footer bg-white text-end">
        <a class="btn btn-link" asp-action="Index">Cancel</a>
        <button class="btn btn-primary" type="submit">Save shift</button>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
