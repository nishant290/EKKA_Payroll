@model Company
@{
    ViewData["Title"] = "Company";
}

<div class="page-head"><h1>Company details</h1></div>

<div class="row g-3">
    <div class="col-lg-8">
        <form asp-action="Index" method="post" class="card">
            <div class="card-header">Employer information</div>
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
                <div class="row g-3">
                    <div class="col-md-6"><label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger small"></span></div>
                    <div class="col-md-6"><label asp-for="TradingName" class="form-label"></label>
                        <input asp-for="TradingName" class="form-control" /></div>
                    <div class="col-md-6"><label asp-for="IrdNumber" class="form-label"></label>
                        <input asp-for="IrdNumber" class="form-control" placeholder="xx-xxx-xxx" /></div>
                    <div class="col-md-6"><label asp-for="Nzbn" class="form-label"></label>
                        <input asp-for="Nzbn" class="form-control" /></div>
                    <div class="col-md-6"><label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger small"></span></div>
                    <div class="col-md-6"><label asp-for="Phone" class="form-label"></label>
                        <input asp-for="Phone" class="form-control" /></div>
                    <div class="col-md-6"><label asp-for="AddressLine1" class="form-label"></label>
                        <input asp-for="AddressLine1" class="form-control" /></div>
                    <div class="col-md-6"><label asp-for="AddressLine2" class="form-label"></label>
                        <input asp-for="AddressLine2" class="form-control" /></div>
                    <div class="col-md-4"><label asp-for="Suburb" class="form-label"></label>
                        <input asp-for="Suburb" class="form-control" /></div>
                    <div class="col-md-4"><label asp-for="City" class="form-label"></label>
                        <input asp-for="City" class="form-control" /></div>
                    <div class="col-md-4"><label asp-for="Postcode" class="form-label"></label>
                        <input asp-for="Postcode" class="form-control" /></div>
                    <div class="col-md-6"><label asp-for="PayFrequency" class="form-label"></label>
                        <select asp-for="PayFrequency" asp-items="Html.GetEnumSelectList<PayFrequency>()" class="form-select"></select></div>
                </div>
            </div>
            <div class="card-footer bg-white text-end"><button class="btn btn-primary" type="submit">Save changes</button></div>
        </form>
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">Company bank accounts</div>
            @if (Model.BankDetails.Count == 0)
            {
                <div class="card-body text-muted small">Add the account you pay staff from.</div>
            }
            else
            {
                <ul class="list-group list-group-flush">
                    @foreach (var b in Model.BankDetails)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-start">
                            <div>
                                <div class="fw-semibold">@b.AccountName @if (b.IsDefault) { <span class="badge bg-info text-dark">Default</span> }</div>
                                <div class="small text-muted">@b.BankName · @b.AccountNumber</div>
                            </div>
                            <form asp-action="DeleteBank" asp-route-id="@b.Id" method="post"
                                  onsubmit="return confirm('Remove this bank account?');">
                                <button class="btn btn-sm btn-link text-danger p-0" title="Remove"><i class="bi bi-trash"></i></button>
                            </form>
                        </li>
                    }
                </ul>
            }
            <form asp-action="AddBank" method="post" class="card-body border-top">
                <div class="section-title mt-0">Add account</div>
                <input name="BankName" class="form-control form-control-sm mb-2" placeholder="Bank (e.g. ANZ)" required />
                <input name="AccountName" class="form-control form-control-sm mb-2" placeholder="Account name" required />
                <input name="AccountNumber" class="form-control form-control-sm mb-2" placeholder="12-3456-1234567-00"
                       pattern="\d{2}-\d{4}-\d{7}-\d{2,3}" required />
                <div class="form-check mb-2">
                    <input type="checkbox" name="IsDefault" value="true" class="form-check-input" id="coDefault" />
                    <label class="form-check-label small" for="coDefault">Default account</label>
                </div>
                <button class="btn btn-sm btn-outline-primary" type="submit">Add bank account</button>
            </form>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
