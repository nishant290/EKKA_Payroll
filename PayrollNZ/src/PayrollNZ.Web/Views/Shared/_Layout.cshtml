<!DOCTYPE html>
<html lang="en-NZ">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – EKAA Payroll</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@{
    string Active(string controller) =>
        string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), controller, StringComparison.OrdinalIgnoreCase)
            ? "active" : "";
}
<div class="app-shell">
    <aside class="sidebar">
        <a class="brand" asp-controller="Home" asp-action="Index"><i class="bi bi-cash-coin"></i> EKAA Payroll</a>
        <nav class="nav flex-column">
            <a class="nav-link @Active("Home")" asp-controller="Home" asp-action="Index"><i class="bi bi-speedometer2"></i> Dashboard</a>
            <a class="nav-link @Active("Employees")" asp-controller="Employees" asp-action="Index"><i class="bi bi-people"></i> Employees</a>
            <a class="nav-link @Active("Schedule")" asp-controller="Schedule" asp-action="Index"><i class="bi bi-calendar-week"></i> Schedule</a>
            <a class="nav-link @Active("Timesheets")" asp-controller="Timesheets" asp-action="Index"><i class="bi bi-clock-history"></i> Timesheets</a>
            <a class="nav-link @Active("PayRuns")" asp-controller="PayRuns" asp-action="Index"><i class="bi bi-wallet2"></i> Pay runs</a>
            <a class="nav-link @Active("Company")" asp-controller="Company" asp-action="Index"><i class="bi bi-building"></i> Company</a>
        </nav>
    </aside>

    <div class="main">
        <header class="topbar">
            <span class="text-muted small">@User.Identity?.Name</span>
            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                <button type="submit" class="btn btn-sm btn-outline-secondary ms-3"><i class="bi bi-box-arrow-right"></i> Sign out</button>
            </form>
        </header>

        <main class="content">
            @if (TempData["Success"] is string ok)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">@ok
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
            }
            @if (TempData["Error"] is string err)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">@err
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
            }
            @RenderBody()
        </main>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
